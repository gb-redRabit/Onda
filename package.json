{
  "name": "onda",
  "desktopName": "onda",
  "version": "0.11.0",
  "description": "Onda — a local-first media player and library for audio, video, YouTube and SoundCloud.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.13.0",
  "main": "./out/main/index.js",
  "author": "gb-redRabit",
  "homepage": "https://github.com/gb-redRabit/Onda",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "check:catch": "node scripts/check-catch.mjs",
    "check:dupes": "node scripts/check-duplicate-imports.mjs",
    "version:check": "node scripts/check-version.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "ipc:inventory": "node scripts/ipc-inventory.mjs",
    "ipc:gen": "node scripts/gen-ipc.mjs",
    "ipc:gen:check": "node scripts/gen-ipc.mjs --check",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:network": "node scripts/run-network-test.mjs",
    "test:network:online": "node scripts/run-network-test.mjs src/main/__tests__/online-network-smoke.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^6.0.0",
    "clsx": "^2.1.1",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3",
    "megajs": "^1.3.10",
    "music-metadata": "^12.0.0",
    "node-id3": "^0.2.9",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lucide/vue": "^1.24.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/vue-virtual": "^3.13.32",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jassub": "^2.5.7",
    "jsdom": "^30.1.2",
    "lfa-ponyfill": "^1.1.1",
    "pinia": "^4.0.3",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.1.6"
  }
}
