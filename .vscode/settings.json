  "i18n-ally.sourceLanguage": "pl",
  "i18n-ally.displayLanguage": "pl",
  "i18n-ally.localesPaths": [
    "src/renderer/src/locales"
  ],
  "vue-i18n.i18nPaths": "dist\\win-unpacked\\locales,src\\renderer\\src\\locales"
}
