{
  "name": "Trójkątna okładka",
  "version": "1.0.0",
  "description": "Przykładowa wtyczka: kształt okładki w widoku audio przez własne warianty dekoracji (plugin:cover:*).",
  "author": "Onda",
  "entry": "index.js",
  "apiVersion": "1",
  "permissions": {
    "visual": true,
    "notifications": true
  },
  "hooks": ["app:start", "track:play"],
  "layoutElements": [
    { "element": "cover", "variant": "triangle", "label": "Trójkąt" },
    { "element": "cover", "variant": "circle", "label": "Koło" },
    { "element": "cover", "variant": "diamond", "label": "Romb" },
    { "element": "cover", "variant": "hexagon", "label": "Sześciokąt" }
  ],
  "settings": [
    {
      "key": "shape",
      "label": "Domyślny kształt",
      "type": "text",
      "default": "triangle"
    },
    {
      "key": "notifyOnChange",
      "label": "Powiadamiaj o zmianie kształtu",
      "type": "boolean",
      "default": true
    }
  ]
}
